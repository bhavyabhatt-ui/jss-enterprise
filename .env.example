# ==============================================================================
# JSS ENTERPRISE - INVOICEIQ ENVIRONMENT CONFIGURATION FOR VERCEL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
# Default username & password if not provided: adminjss / jss2026
ADMIN_USERNAME=adminjss
ADMIN_PASSWORD=jss2026

# Optional: Session encryption key (any random long string)
AUTH_SECRET=jss_enterprise_secure_token_secret_2026_xyz

# ------------------------------------------------------------------------------
# 2. GLOBAL CLOUD PERSISTENCE (Choose ANY ONE option below for all devices to sync)
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# OPTION A: Upstash Redis / Vercel KV (RECOMMENDED FOR VERCEL)
# ------------------------------------------------------------------------------
# In your Vercel Dashboard:
# 1. Go to your project -> Click "Storage" tab
# 2. Click "Create Database" -> Select "KV" (Powered by Upstash)
# 3. Click "Connect to Project"
# Vercel will automatically populate these variables for you:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Or if you created a free Redis database directly on https://upstash.com:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# OPTION B: MongoDB Atlas (FREE CLOUD DATABASE)
# ------------------------------------------------------------------------------
# 1. Go to https://www.mongodb.com/atlas and create a free Shared M0 cluster
# 2. Click "Connect" -> "Drivers" -> Copy your connection URI string
# 3. Paste it here:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/jss_enterprise?retryWrites=true&w=majority
